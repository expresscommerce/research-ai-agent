# ═══════════════════════════════════════════════════
# Agentic AI Research Platform — Configuration
# ═══════════════════════════════════════════════════

# --- Database ---
DATABASE_URL=postgresql+asyncpg://researcher:researcher_secret@localhost:5432/research_platform

# --- Security ---
SECRET_KEY=change-me-to-a-64-char-random-string
ENCRYPTION_KEY=

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Agent Config ---
DEFAULT_MODEL=openai/gpt-4o-mini
MAX_ITERATIONS=3
QUALITY_THRESHOLD=75
AGENT_TIMEOUT=120
TAVILY_API_KEY=
ENABLE_TAVILY=true
ENABLE_DUCKDUCKGO=true
ENABLE_ARXIV=true
POSTGRES_PORT=5432
QDRANT_PORT=6333
BACKEND_PORT=8000
NGINX_PORT=80


